# THE ADMIRAL'S ePADD APPS.
#
# The right-hand panel ACTS - what is building, who is where, the live status line, all in
# a column beside the map. The PADD READS: the things that want the whole screen and are
# not a glance and a decision. That is the same division the two devices already make on a
# bridge, and it is why these are PADD routes rather than more tiles on the panel.
#
# Both screens were already written - `research_list` / `requisition_catalog_items` and
# their templates have sat in universe_research.py with NO .mast calling them since the tab
# console was retired. They were reachable only by finding the Lab or the HQ on the map and
# opening its comms menu, which is a discovery problem dressed as a feature. The comms
# routes stay exactly as they are; this is a second door for a crew who would rather read.
#
# Quests are not here: the ePADD's own Quests app follows the console's quest HOLDER, and
# the Admiral console names the side's Admiralty as its holder (admiralty_use_command), so
# it lists the side's war aims with no work from this file.

# Registered at top level so the tiles exist before anyone opens the PADD. `consoles=`
# scopes them to this console - the bridge has no use for a research tree it cannot start.
gui_app_register("research", title="Research", icon="epadd.status", group="Command", sort=20, consoles="admiral", description="Milestones, and what to start next", status=admiral_padd_research_badge)
gui_app_register("supply", title="Supply", icon="epadd.fabricate", group="Command", sort=30, consoles="admiral", description="Requisition from the Quartermaster")


//gui/app/research if UNIVERSE_ACTIVE and admiralty_active()
--- research_paint
    gui_tab_back(CONSOLE_SELECT)
    adm_pr_side = universe_console_side(client_id)
    # THE PADD'S OWN TITLE BAR, not one of our own. `gui_app_chrome` owns the band from
    # 45px to 109px - clear of the tab strip AND of the engine's Options button - and
    # every PADD screen's body starts at 109px. Hand-rolling a band at 2% put this
    # screen's title over both, which is what it was doing.
    gui_app_chrome("Research")
    gui_section(style="area: 0, 109px, 100, 84;")
    # The rows carry each milestone's state for THIS side (available / running / done),
    # so a second Admiral on another side reads its own tree.
    adm_pr_box = gui_list_box(research_list(), "row-height: 2.2em;", item_template=research_list_template_for(adm_pr_side), title_template=research_list_title, select=True)
    gui_section(style="area: 0, 85, 100, 93;")
    adm_pr_hint = gui_text("$text:" + admiralty_msg(adm_pr_side) + ";justify:center;font:gui-1;color:#8cf")
    on change admiralty_msg(adm_pr_side):
        adm_pr_hint.update("text:" + admiralty_msg(adm_pr_side) + ";justify:center;font:gui-1;color:#8cf")
    gui_section(style="area: 0, 93, 100, 100;")
    adm_pr_go = gui_button("$text:Begin selected research;font:gui-1;justify:center;")
    on gui_message(adm_pr_go):
        adm_pr_pick = adm_pr_box.get_value()
        if adm_pr_pick is not None:
            # The SAME path the Lab's comms button takes - one validator, one task, one
            # place that spends the resources.
            task_schedule(admiral_overseer_research, {"RESEARCH_PICK": adm_pr_pick.get("key"), "ADM_ACT_SIDE": adm_pr_side})
    await gui()


//gui/app/supply if UNIVERSE_ACTIVE and admiralty_active()
--- supply_paint
    gui_tab_back(CONSOLE_SELECT)
    adm_sup_side = universe_console_side(client_id)
    gui_app_chrome("Supply")
    gui_section(style="area: 0, 109px, 100, 84;")
    adm_sup_box = gui_list_box(requisition_catalog_items(adm_sup_side), "row-height: 2.2em;", item_template=requisition_list_template, title_template=requisition_list_title, select=True)
    gui_section(style="area: 0, 85, 100, 93;")
    adm_sup_hint = gui_text("$text:" + admiralty_msg(adm_sup_side) + ";justify:center;font:gui-1;color:#8cf")
    on change admiralty_msg(adm_sup_side):
        adm_sup_hint.update("text:" + admiralty_msg(adm_sup_side) + ";justify:center;font:gui-1;color:#8cf")
    gui_section(style="area: 0, 93, 100, 100;")
    adm_sup_go = gui_button("$text:Requisition selected;font:gui-1;justify:center;")
    on gui_message(adm_sup_go):
        adm_sup_pick = adm_sup_box.get_value()
        if adm_sup_pick is not None:
            task_schedule(admiral_overseer_requisition, {"REQ_PICK": adm_sup_pick.get("key"), "REQ_SIDE": adm_sup_side})
    await gui()
