{
  "version": "2.0.0",
  "tasks": [
    {
      // Build the mastlibs into ..\__lib__ (universe_core + admiral). Ctrl+Shift+B.
      // Needed after ANY change under universe_core/ or admiral/: a mission loads the
      // PACKAGED mastlib, so an unbuilt edit is invisible to the engine.
      "label": "build_addons",
      "type": "shell",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/C"
          ]
        }
      },
      "command": "..\\sbs.pyz lib OpenUniverse",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      // Publish the mastlibs as a release (-u updates the existing tag).
      "label": "rerelease",
      "type": "shell",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/C"
          ]
        }
      },
      "command": "..\\sbs.pyz release OpenUniverse \"Dev v1.4.0\" -u",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "group": {
        "kind": "release",
        "isDefault": true
      }
    },
    {
      "label": "serve",
      "type": "shell",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/C"
          ]
        },
        "cwd": "${workspaceFolder}/mkdocs",
        "env": {
          "PATH": "C:\\Program Files\\Git\\bin;${env:PATH}"
        }
      },
      "command": "mkdocs serve",
      "problemMatcher": [],
      "group": {
        "kind": "mkdocs",
        "isDefault": false
      }
    },
    {
      "label": "pub docs",
      "type": "shell",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/C"
          ]
        },
        "cwd": "${workspaceFolder}/mkdocs",
        "env": {
          "PATH": "C:\\Program Files\\Git\\bin;${env:PATH}"
        }
      },
      "command": "mkdocs gh-deploy --force",
      "problemMatcher": [],
      "group": {
        "kind": "mkdocs",
        "isDefault": false
      }
    }
  ]
}
