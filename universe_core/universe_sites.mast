# Arriving at an boarding site.
#
# `universe_sites.py` owns the seam - reading a `Site:` file, binding it to the landmark's
# object, releasing it with the cell. This owns the ARRIVAL: noticing that a crew has
# reached one, offering the call, and opening the visit.
#
# Two ways to arrive, because a site is whatever the landmark is:
#
#   * DOCK with it - a colony, an outpost, a station that stopped answering, a derelict.
#   * ORBIT it - a worldlet.
#
# Both end in the same place, so the difference is one route each and nothing else.
#
# TWO KINDS OF PLACE, and the file does not choose between them here either. A site
# whose key is also the key of a tile area (`area: <key>` in a `.tiles` file in the
# universe's folder) is WALKED: the party stands on that map, and it is over when the
# last of them is back aboard. Any other site is the text visit: a first room, and it is
# over when the scene closes. `universe_site_area(key)` is the whole question.
#
# THE FILE SAYS WHEN THE TEAM GOES DOWN. The arrival call is a `## Hails` scene, and the
# choice that accepts carries `; signal boarding_down`:
#
#     - [Assemble a boarding party]() ; signal boarding_down
#     - [Hold position]()
#
# A declared signal rather than this file reading the button text. Matching on words like
# "beam" or "down" works for exactly the phrasings whoever wrote the matcher imagined, and
# fails silently for "Assemble a boarding party" - the author gets a place the crew can
# reach, can answer, and can never enter, with nothing logged.
#
# A site with no `## Hails` section goes down on arrival, since there was nothing to ask.


# Long enough that the call does not arrive on top of the docking clunk.
default shared UNIVERSE_SITE_CALL_DELAY = 4


//shared/signal/ship_docked
    ->END if not has_role(DOCK_STATION_ID, "boarding_site")
    task_schedule(universe_site_arrive, {"SITE_SHIP": DOCK_SHIP_ID, "SITE_OBJECT": DOCK_STATION_ID})
    ->END


//shared/signal/ship_orbiting
    ->END if not has_role(ORBIT_BODY_ID, "boarding_site")
    task_schedule(universe_site_arrive, {"SITE_SHIP": ORBIT_SHIP_ID, "SITE_OBJECT": ORBIT_BODY_ID})
    ->END


# The crew has reached a site. Offer the call, or go straight down if there is none.
=== universe_site_arrive
    universe_site_key = get_inventory_value(SITE_OBJECT, "SITE_KEY", None)
    ->END if universe_site_key is None
    # Somebody is already down there. With two ships in two systems that is a live case
    # rather than a corner: the boarding module holds ONE open scene, so a second crew
    # arriving would take over the first crew's beat.
    ->END if boarding_visiting() is not None or boarding_is_open()
    # Not "was this site ever asked": a crew that answered "Stay aboard" was then never
    # called again. Only a call that is still OUT - being placed, waiting, or open - is
    # a reason not to place another (`universe_site_call_waiting` re-arms the rest).
    ->END if universe_site_call_waiting(SITE_OBJECT)

    universe_site_scenes_now = universe_site_scenes(universe_site_key)
    # A WALKED site may have nothing to say and still be somewhere to go.
    ->END if (universe_site_scenes_now is None or len(universe_site_scenes_now) == 0) and universe_site_area(universe_site_key) is None

    # Which site the answer belongs to. Held on the SHIP because that is what the hail
    # was offered to, and because two ships can each have a different call pending.
    set_inventory_value(SITE_SHIP, "SITE_PENDING", SITE_OBJECT)

    universe_site_hails_now = universe_site_hails(universe_site_key)
    if universe_site_hails_now is None or len(universe_site_hails_now) == 0:
        # Nothing to ask, so nothing to wait for.
        task_schedule(universe_site_descend, {"SITE_SHIP": SITE_SHIP, "SITE_OBJECT": SITE_OBJECT})
        ->END

    set_inventory_value(SITE_OBJECT, "SITE_ASKED", True)
    # ...and BEING PLACED, for the seconds below: a second ship tying up in them must
    # not start a second call.
    set_inventory_value(SITE_OBJECT, "SITE_CALLING", True)
    await delay_sim(UNIVERSE_SITE_CALL_DELAY)
    set_inventory_value(SITE_OBJECT, "SITE_CALLING", False)
    # Fire and forget: the ACCEPT choice's `; signal boarding_down` is what continues this,
    # so a crew that ignores the call simply never goes down, and one that declines can
    # be asked again by re-arming below.
    universe_site_entry = next(iter(universe_site_hails_now), None)
    hail_offer(SITE_SHIP, scene=universe_site_entry, scenes=universe_site_hails_now)
    ->END


# The file's accept choice fired. `//shared/signal`, so a six console bridge sends ONE
# team down rather than six.
//shared/signal/boarding_down
    universe_site_down_ship = next(iter(role("__player__")), None)
    ->END if universe_site_down_ship is None
    universe_site_down_obj = get_inventory_value(universe_site_down_ship, "SITE_PENDING", None)
    ->END if universe_site_down_obj is None
    task_schedule(universe_site_descend, {"SITE_SHIP": universe_site_down_ship, "SITE_OBJECT": universe_site_down_obj})
    ->END


# Down they go.
=== universe_site_descend
    ->END if boarding_visiting() is not None or boarding_is_open()
    universe_site_dkey = get_inventory_value(SITE_OBJECT, "SITE_KEY", None)
    ->END if universe_site_dkey is None
    universe_site_dscenes = universe_site_scenes(universe_site_dkey)
    universe_site_darea = universe_site_area(universe_site_dkey)
    ->END if (universe_site_dscenes is None or len(universe_site_dscenes) == 0) and universe_site_darea is None

    # THE CREW GO AS THEMSELVES, and one call owns the whole visit. `boarding_visit`
    # opens a party made of the people already at the consoles - their name, face and
    # `Roles:` - begins the first room, and when the scene closes it shuts the party
    # and brings every console home.
    #
    # This used to begin the scene and then emit `boarding_begin`, whose only listener
    # is the legacy away console (off by default). So the scene opened, nobody was
    # ever seated in it, and because it was never closed either, every later arrival
    # at any site saw "somebody is already down there" and stopped.
    # `place=` is the SITE'S KEY: what the party works out here is kept under it, so two
    # sites that happen to share a title do not share what was learned at them.
    if universe_site_darea is not None:
        # A WALKED SITE. No first room: the party stands at the area's `entry:` and a
        # scene belongs to the thing or the person that opens it. Its side stories are
        # handed out as each person arrives. Nothing here ends it - the last of the
        # party coming home does (`boarding_came_back`, at the foot of this file).
        universe_site_invite = boarding_visit(SITE_SHIP, universe_site_dscenes, None, title=universe_site_title(universe_site_dkey), area=universe_site_darea, place=universe_site_dkey, stories=universe_site_stories(universe_site_dkey))
    else:
        universe_site_first = next(iter(universe_site_dscenes), None)
        universe_site_invite = boarding_visit(SITE_SHIP, universe_site_dscenes, universe_site_first, title=universe_site_title(universe_site_dkey), place=universe_site_dkey)
    set_inventory_value(SITE_SHIP, "SITE_PENDING", None)
    if universe_site_invite is None:
        universe_site_say(f"the site '{universe_site_dkey}': the visit would not open")
        ->END
    # Which site this ship is at, so the end of the visit can hand it back.
    set_inventory_value(SITE_SHIP, "SITE_VISITING", SITE_OBJECT)
    # A party nobody joins, and a ship that then lets go of the place: over.
    universe_site_visit_watch(SITE_SHIP)
    log(f"site '{universe_site_dkey}': party open, scene={boarding_scene()}", "universe")
    ->END


# The visit is over: everyone is back aboard. Re-arm the site, so docking again offers
# the call again - a crew that beamed up early can go back for what they missed.
//shared/signal/boarding_visit_ended
    universe_site_was = get_inventory_value(BOARDING_SHIP, "SITE_VISITING", None)
    ->END if universe_site_was is None
    set_inventory_value(BOARDING_SHIP, "SITE_VISITING", None)
    set_inventory_value(universe_site_was, "SITE_ASKED", False)
    ->END


# A WALKED site has no scene to close, so it ends when the LAST of the party is back
# aboard: each console that beams up sends this, and the one that leaves the map empty
# ends the visit - which sends `boarding_visit_ended`, above, and that re-arms the site.
#
# `//shared/signal`: it ENDS a visit, so it runs once, on the server, however many
# consoles are connected. The whole test is in `universe_site_visit_leave` (it does
# nothing for a text visit, for a visit this file did not open, or while anybody is
# still on the ground). At the END of the file, after every other label.
//shared/signal/boarding_came_back
    universe_site_visit_leave()
    ->END


# A DERELICT is docked with like a station, and it is nobody's: the station brain asks
# for an ally, and a wreck has no side to be one. This is that brain without the
# question and without the dockyard - no fuel, no torpedoes, no repair. All it does is
# say the ship has tied up, once per docking (`ship_docked`, the same signal a station
# sends, so quests and the route at the top of this file hear it the same way).
=== universe_site_dock_with_derelict
metadata: ``` yaml
distance: 600
```
+++ enable
    yield fail if DOCKING_NPC_ID == 0

+++ undocking
    set_inventory_value(DOCKING_PLAYER_ID, "_docked_fired", False)

+++ docked
    if not get_inventory_value(DOCKING_PLAYER_ID, "_docked_fired", False):
        set_inventory_value(DOCKING_PLAYER_ID, "_docked_fired", True)
        signal_emit("ship_docked", {"DOCK_SHIP_ID": DOCKING_PLAYER_ID, "DOCK_STATION_ID": DOCKING_NPC_ID})
