# universe_core - the generic multi-system exploration engine (OpenUniverse Phase 2b
# split of the former monolithic `universe/` addon). A story/campaign mission loads
# THIS mastlib alone (Mode: story / campaign - no admiral economy). The admiral RTS
# lives in the separate `admiral/` addon (admiral mastlib); core detects it at RUNTIME
# via admiral_present() (universe_mode.py), so loading core WITHOUT admiral is fully
# valid - every admiral call-site in core is guarded by admiral_present()/admiralty_active().
#
# Helpers/data first, then the map itself. The example UNIVERSES are NOT here:
# a universe is mission CONTENT, the same way LM keeps its maps out of its addons,
# so a mission building on this engine gets no universes it did not ask for.
# Helpers/data first, then the map itself (shared MAST namespace:
# later files call the earlier helpers by bare name).
import universe_helpers.py
import universe_mode.py
import universe_doc.py
import universe_sides.py
import universe_amd.py
import universe_reputation.py
import universe_side_quests.py
import universe_dialogue.py
import universe_captains.py
import universe_lifeforms.py
import universe_regions.py
import universe_landmarks.py
import universe_goods.py
import universe_systems.py
import universe_codex.mast
import universe.mast
