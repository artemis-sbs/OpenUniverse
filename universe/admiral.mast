# The Admiral console - slice 1 (see ADMIRAL_CONSOLE.md).
# A strategic console ON THE PLAYER SIDE: worldlets, extraction, and the side
# stockpiles. This slice: the resource ticker, the Map tab (worldlet list +
# selection + info), and HQ/Extractor builds feeding the extraction tick.
# Later slices add Build/Research/Fleets/Requisition content to the tabs.
#
# Economy state lives on the side agent (universe_worldlets.py); the console
# only presents it, so any number of Admiral consoles can join one side
# (decision: multi-Admiral co-op, last command wins).

default shared ADMIRAL_TAB = "map"
shared ADM_BUILDS = []
# The overseer's last action result (build/commission/research confirmation or a
# rejection reason). Surfaced in the overseer status line since that console has no
# info panel; also mirrored to info cards for the tab console / other consoles.
default shared ADM_LAST_MSG = ""


# Started by @map/universe when the universe has an Admiralty chapter. One
# global task: every tick, extractor platforms pull their worldlet's yields
# into the side pools (per-minute rates, scaled by the tick seconds).
=== admiralty_economy_tick
--- econ_loop
    await delay_sim(6)
    ->END if not UNIVERSE_ACTIVE
    # Per player side: seed pools (retry until the side agent exists at map
    # start), scan its own theatre for comms, tick extraction/relay income, and
    # drain the crew subsidy. Iterating the roster is what makes the economy
    # multi-side; with one player side this runs exactly once (unchanged).
    for _side in universe_player_sides():
        if admiralty_seed_pools(_side):
            universe_save_players()
        admiralty_scan_theatre(_side)
        admiralty_extraction_tick(_side, 6)
        admiralty_relay_tick(_side, universe_sectors, universe_i, universe_j, 6)
        subsidy_lapse = admiralty_subsidy_upkeep(_side, 6)
        if subsidy_lapse is not None:
            universe_info_card(subsidy_lapse, "Admiralty Quartermaster", "#fa4")
    # Keep this system's persistence delta fresh (worldlet depletion + platforms
    # built here + per-minute income) so jumps/saves carry the infrastructure.
    # TODO(multi-side): the platform/relay snapshots are per-primary-side; make
    # them per-side when >1 player side builds in the same sector.
    _psnap = universe_primary_side()
    universe_sectors = universe_set_system_value(universe_sectors, universe_i, universe_j, "worldlet_reserves", worldlets_snapshot_reserves())
    universe_sectors = universe_set_system_value(universe_sectors, universe_i, universe_j, "admiral_platforms", admiralty_snapshot_platforms(_psnap))
    universe_sectors = universe_set_system_value(universe_sectors, universe_i, universe_j, "adm_relay", admiralty_relay_snapshot(_psnap))
    jump econ_loop


# The navy's heartbeat: every few seconds each fleet executes its order
# (universe_fleets.fleet_tick - movement/targeting/gas/salvage). Officer
# events (fleet lost, salvage hauls, dry tanks) reach the crews as info-panel
# cards in the officer's face and name - chatter never rides the waterfall.
=== admiralty_fleet_loop
--- fleet_loop
    await delay_sim(3)
    ->END if not UNIVERSE_ACTIVE
    veiled_now = region_is_veiled(UNIVERSE_REGIONS, universe_i, universe_j)
    for _fl in fleet_list():
        fleet_evt = fleet_tick(_fl.key, 3, veiled_now)
        if fleet_evt is not None:
            officer_card(fleet_evt.officer, fleet_evt.text)
    # MIA captains (slice 4): pod rescues, captures, lapsed beacons - per side.
    # Rescued officers speak for themselves; captures/losses are Admiralty traffic.
    for _side in universe_player_sides():
        for mia_evt in officer_mia_tick(_side, 3, UNIVERSE_CLANS):
            if mia_evt.officer is None:
                universe_info_card(mia_evt.text, "Admiralty Operations", "#f66")
            else:
                officer_card(mia_evt.officer, mia_evt.text)
    jump fleet_loop


# Border skirmishes (slice 4): pressure from foe territory adjacency draws
# periodic raids on the side's platforms - but only once the navy exists
# (universe_skirmish.py decides; this loop spawns and alerts). Raids prefer
# a standing Bastion, so the fort is where the fight happens.
=== admiralty_skirmish_loop
--- skirmish_loop
    await delay_sim(10)
    ->END if not UNIVERSE_ACTIVE
    for _side in universe_player_sides():
        raid = skirmish_tick(_side, UNIVERSE_CLANS, universe_seed, universe_i, universe_j, DANGER, 10)
        if raid is not None:
            raid_clan = clan_get(UNIVERSE_CLANS, raid.clan)
            prefab_spawn(prefab_fleet_raider, {"race": clan_pick_race(raid_clan), "fleet_difficulty": raid.difficulty, "ship_roles": raid.clan + ", raider, skirmish", "START_X": raid.x, "START_Y": raid.y, "START_Z": raid.z})
            universe_info_card("ALERT - " + clan_name(UNIVERSE_CLANS, raid.clan) + " skirmish raid inbound on " + raid.target + ".", "Admiralty Operations", "#f66")
    jump skirmish_loop


# Build model B: the Fabricator. Drives the builder ship through its queue -
# fly to the next worldlet, construct, repeat (universe_fabricator.fabricator_tick).
# A no-op under the default menu model (nothing ever enqueues). Events (relaunch,
# build complete) reach the crews as Admiralty cards.
=== admiralty_fabricator_loop
--- fab_loop
    await delay_sim(2)
    ->END if not UNIVERSE_ACTIVE
    for _side in universe_player_sides():
        fab_evt = fabricator_tick(_side, 2)
        if fab_evt is not None:
            universe_info_card(fab_evt, "Admiralty Fabricator", "#0cf")
    jump fab_loop


# One platform build: cost was already paid (admiralty_try_build); wait out
# the build time, then the platform appears beside its worldlet.
=== admiralty_build_task
    default build_kind = "extractor"
    default build_worldlet_id = None
    default build_side = universe_primary_side()
    pdef = admiralty_platform_def(build_kind)
    ->END if pdef is None or build_worldlet_id is None
    build_label = pdef.get("name") + " at " + str(to_object(build_worldlet_id).name)
    ADM_BUILDS.append(build_label)
    await delay_sim(pdef.get("build_time"))
    ADM_BUILDS.remove(build_label)
    built_plat = admiralty_build_done(build_kind, build_side, build_worldlet_id)
    # Completion lands on the overseer status line (the platform also appears on the
    # 2D view); keeps the "did it finish?" question answered.
    ADM_LAST_MSG = pdef.get("name") + " complete."
    # Force-refresh the comms buttons of any overseer that has this worldlet selected
    # so the newly unlocked builds appear without re-clicking (comms_navigate_override
    # no-ops for cameras not currently on this pair - "only if it's selected"). Scoped
    # to the building side's cameras (& role(build_side)) so a rival Admiral isn't refreshed.
    comms_navigate_override(role("admiral_cam") & role(build_side), build_worldlet_id)
    # A finished Sensor Relay senses this system's neighbourhood - the galaxy map
    # reveals those cells' contents without a visit (fog of war, the relay's
    # second CQ role). Persist the intel.
    if build_kind == "sensor" and built_plat is not None:
        universe_sectors = universe_reveal_neighbors(universe_sectors, universe_i, universe_j)
        universe_save(universe_seed, universe_i, universe_j, universe_sectors)
        universe_info_card("Sensor Relay online - the neighbouring systems are on the chart.", "Admiralty", "#0cf")
    ->END


# One research run: cost was already paid (research_try_start); wait out the
# Time, then record the milestone (effects apply from the completed set) and
# persist the campaign.
=== admiralty_research_task
    default research_key = None
    default research_side = universe_primary_side()
    rdef = research_def(research_key)
    ->END if rdef is None
    research_label = "Research - " + rdef.get("name")
    ADM_BUILDS.append(research_label)
    await delay_sim(rdef.get("time"))
    ADM_BUILDS.remove(research_label)
    research_complete(research_side, research_key)
    universe_save_players()
    universe_info_card("Research complete: " + rdef.get("name") + ".", "Admiralty", "#0cf")
    ->END


@console/admiral !0 ^10 "Admiral" if UNIVERSE_ACTIVE and admiralty_active()
    " The war effort behind the fleet - worldlets, extraction, and stockpiles.
    default SEL_WORLDLET = None
    default ADM_MSG = ""
    # A/B: `Admiral view: overseer` detaches onto a camera with a system-wide 2D
    # command view (GM-style); the default `bridge` is the tab console.
    jump admiral_overseer_gui if admiralty_tuning("admiral_view", "bridge") == "overseer"
    jump admiral_console_gui


# Overseer mode (A/B, prototype). The Admiral rides a private camera object (the
# GM cambot pattern - invisible, has_science_scan, all friendlies as scan
# sources, big scan range) rather than a combat hull, and commands from a
# system-wide 2D view. Step 1: the detached view + ticker; object-select popups
# (build / fleet orders) and comms come next.
=== admiral_overseer_gui
    default ADM_MSG = ""
    default ADM_JUMP_I = "0"
    default ADM_JUMP_J = "0"
    # The camera the Admiral rides: invisible, sees all friendlies (has_science_scan
    # + extra_scan_source), tagged `admiral` so the comms routes recognise it as an
    # Admiral origin (LM give-orders + OU routes guard on that role). No "admiral"
    # in the CONSOLE name below - the dispatcher routes "admiral"+2dview to science
    # selection but "comm" to comms selection, and we want comms (for popups).
    adm_cam_id = get_inventory_value(client_id, "ADMIRAL_CAM", None)
    adm_cam = to_object(adm_cam_id)
    if adm_cam_id is None or adm_cam is None:
        adm_cam = to_object(player_spawn(0, 1000, 0, "", "#,admiral_cam,admiral,has_science_scan", "invisible"))
        remove_role(adm_cam, "__player__")
        adm_cam_id = to_id(adm_cam)
        set_inventory_value(client_id, "ADMIRAL_CAM", adm_cam_id)
        link(adm_cam_id, "extra_scan_source", any_role("__npc__,__player__"))
        # The overseer commands the client's own side (its ship's side, or the
        # primary player side) - not a hard-coded literal.
        adm_cam.side = universe_console_side(client_id)
        adm_cam.data_set.set("ship_base_scan_range", 40000, 0)
        # Model A: the overseer camera starts on the current cell.
        ship_set_cell(adm_cam_id, universe_i, universe_j)
    sbs.assign_client_to_ship(client_id, adm_cam_id)
    # Register the camera as an occupant of its cell (idempotent) and place it at
    # that cell's world slot, so the cell lifecycle counts the overseer as a
    # viewer (its system stays live; an empty one it leaves despawns).
    adm_cell = ship_cell(adm_cam_id)
    universe_cell_enter(adm_cell[0], adm_cell[1], adm_cam_id)
    adm_co = universe_cell_origin(adm_cell[0], adm_cell[1])
    adm_cam.pos = Vec3(adm_co.x, 1000, adm_co.z)
    set_comms_selection(adm_cam_id, adm_cam_id)
    # This overseer's side (the flag camera's side); its //comms handlers thread
    # it from COMMS_ORIGIN.side, the tab body reads adm_side directly.
    adm_side = adm_cam.side
    # Console name: `gamemaster_` prefix -> the engine's optimized network path for
    # detached command consoles; `comms` (not `sci`/`admiral`) -> the dispatcher
    # routes 2D-view selection to comms (consoledispatcher.py), which our //comms
    # routes need. The camera's ROLE is `admiral`, not `gamemaster`, so GM menus
    # (gated on the gamemaster role) don't apply - only our Admiral routes.
    gui_activate_console("gamemaster_overseer_comms")
    # Top tabs (the //gui/tab framework, like the hangar's Casino tab): enable the
    # Galaxy tab here; its click is handled by //gui/tab/galaxy. gui_tab_back sets
    # the framework-provided back tab to this console, so the galaxy view returns.
    CONSOLE_SELECT = "admiral"
    gui_tab_enable("galaxy")
    gui_tab_back(CONSOLE_SELECT)
    gui_section(style="area: 2, 2, 98, 8; background:#1578;")
    # Live resource ticker: a plain text label is built once and goes stale, so use
    # a handle + on-change (the pools shift on the economy tick - watch the string
    # and repaint when it changes).
    adm_ticker_w = gui_text("$text:" + admiralty_ticker_text(adm_side) + ";justify:center;font:gui-4")
    on change admiralty_ticker_text(adm_side):
        # .update() replaces the whole style, so carry the format props too (else
        # the text reverts to unstyled/left-aligned).
        adm_ticker_w.update("text:" + admiralty_ticker_text(adm_side) + ";justify:center;font:gui-4")
    # Left: zoom + the system 2D view (click an object to command it).
    gui_section(style="area: 0, 9, 72, 100;")
    gui_row("row-height: 34px;")
    gui_layout_widget("radar_zoom_ctrl")
    gui_row()
    gui_layout_widget("comms_2d_view")
    # Right, top: the selected object's comms face + action menu.
    gui_section(style="area: 72, 9, 100, 66;")
    gui_row("row-height: 100px;")
    gui_layout_widget("comms_face")
    gui_row()
    gui_layout_widget("comms_control")
    # Right, bottom: build-queue / action status, under the comms buttons with real
    # vertical space. This console has no info panel, so the Admiralty's build
    # progress, confirmations and rejection reasons live here (ADM_BUILDS +
    # ADM_LAST_MSG, both shared). The on-change watcher repaints when either changes.
    gui_section(style="area: 72, 67, 100, 100; background:#0234;")
    adm_bwidget = gui_text("$text:" + admiralty_status_line(ADM_BUILDS, ADM_LAST_MSG) + ";justify:center;font:gui-2;color:#8cf")
    on change str(len(ADM_BUILDS)) + "|" + ADM_LAST_MSG:
        adm_bwidget.update("text:" + admiralty_status_line(ADM_BUILDS, ADM_LAST_MSG) + ";justify:center;font:gui-2;color:#8cf")
    # Comms won't open on an object the side holds no science data for. Scan the
    # Admiral's theatre once now so THIS console's first click works; the economy
    # tick keeps it fresh side-wide thereafter (admiralty_scan_theatre is one pass
    # for the whole side - science data is stored per-side, not per-console).
    admiralty_scan_theatre(adm_side)
    await gui()


# Galaxy top tab (//gui/tab framework, like the hangar's Casino). Enabled on the
# Admiral overseer; its click shows the shared galaxy map (the same one the player
# Navigation console uses). "Child knows its parent": set the framework's back tab
# to the console that opened us (CONSOLE_SELECT) so the map can return.
//gui/tab/galaxy
    gui_tab_back(CONSOLE_SELECT)
    gui_tab_enable("galaxy")
    jump universe_galaxy_map_gui


# Overseer self-jump (Model A): relocate the command camera to another system.
# Reuses the per-ship cell lifecycle with the camera as the occupant - the
# destination spawns if the cam is its first occupant, the source despawns if the
# cam was its last. Points the economy's universe_i/j at the watched system so
# build/research/fabrication follow the camera. (Shared with players today - a
# fully per-overseer economy is later work.)
=== universe_admiral_jump
    default ti = universe_i
    default tj = universe_j
    default cam_id = 0
    ->END if cam_id == 0
    cam = to_object(cam_id)
    ->END if cam is None
    asrc = ship_cell(cam_id)
    ->END if ti == asrc[0] and tj == asrc[1]
    if universe_cell_enter(ti, tj, cam_id):
        await task_schedule(universe_enter_system, {"ei": ti, "ej": tj})
    if universe_cell_leave(asrc[0], asrc[1], cam_id):
        standby_cull_clear()
        universe_clear_cell(asrc[0], asrc[1])
    ship_set_cell(cam_id, ti, tj)
    aco = universe_cell_origin(ti, tj)
    cam.pos = Vec3(aco.x, 1000.0, aco.z)
    universe_i = ti
    universe_j = tj
    ->END


=== admiral_console_gui
    default SEL_WORLDLET = None
    default BUILD_SEL = None
    default RESEARCH_SEL = None
    default OFFICER_SEL = None
    default REQ_SEL = None
    default ADM_MSG = ""
    # The side this console commands = the client's own ship side (falls back to
    # the primary player side). The action handlers below run in this same gui
    # task, so they inherit adm_side - no per-handler re-derivation needed.
    adm_side = universe_console_side(client_id)
    ticker = admiralty_ticker_text(adm_side)

    # Resource bar (CQ's resource bar, reborn).
    gui_section(style="area: 2, 2, 98, 9; background:#1578;")
    """$text:{ticker};justify:center;font:gui-4"""

    # Tab strip - Map is live; the rest arrive in later slices.
    gui_section(style="area: 2, 10, 98, 17;")
    gui_row("row-height: 2em;")
    admiral_tabs = [["map","Map"], ["system","System"], ["research","Research"], ["fleets","Fleets"], ["requisition","Requisition"]]
    gui_screen_tabs(admiral_tabs, ADMIRAL_TAB, "admiral_set_tab")

    if ADMIRAL_TAB == "map":
        worldlet_list = worldlets_in_system()
        gui_section(style="area: 2, 18, 58, 82;")
        if len(worldlet_list) == 0:
            """No worldlets in this system. Explore - the survey charts show them on arrival."""
        else:
            wlb = gui_list_box(worldlet_list, "row-height: 2.2em;", item_template=worldlet_list_template, title_template=worldlet_list_title, select=True)
            on change wlb.value:
                sel_item = wlb.get_value()
                if sel_item is not None:
                    SEL_WORLDLET = to_id(sel_item)
                    BUILD_SEL = None
                jump admiral_console_gui

        # Right panel: the selected worldlet's info on top, then a scrollable list
        # of platforms buildable here (only prereq-met ones - the list unlocks as
        # you build) with a Build action for the selection. A list, not a stack of
        # buttons, so it behaves at small screen sizes.
        gui_section(style="area: 60, 18, 98, 40;")
        if SEL_WORLDLET is None:
            """Select a worldlet to inspect it and build."""
        else:
            sel_text = worldlet_sel_text(SEL_WORLDLET, adm_side)
            """$text:{sel_text}"""
        if SEL_WORLDLET is not None:
            gui_section(style="area: 60, 41, 98, 74;")
            blb = gui_list_box(admiralty_buildable_items(adm_side, SEL_WORLDLET, universe_sectors, f"{universe_i},{universe_j}"), "row-height: 2.2em;", item_template=build_list_template, title_template=build_list_title, select=True)
            on change blb.value:
                sel_build = blb.get_value()
                if sel_build is not None:
                    BUILD_SEL = sel_build.key
                jump admiral_console_gui
            gui_section(style="area: 60, 75, 98, 82;")
            if BUILD_SEL is not None:
                build_def = admiralty_platform_def(BUILD_SEL)
                if build_def is not None:
                    build_btn = "Build " + build_def.get("name") + "  (" + admiralty_cost_text(BUILD_SEL) + ")"
                    b_build = gui_button(build_btn)
                    on gui_message(b_build):
                        BUILD_PICK = BUILD_SEL
                        jump admiral_build
        if ADM_MSG != "":
            gui_row("row-height: 2em;")
            """$text:{ADM_MSG};color:#fa4"""
    elif ADMIRAL_TAB == "research":
        # The tech ladder (## Research): scrollable list, actions on the
        # selection (the Map tab's list+context pattern).
        gui_section(style="area: 2, 18, 58, 82;")
        rlb = gui_list_box(research_list(), "row-height: 2.2em;", item_template=research_list_template_for(adm_side), title_template=research_list_title, select=True)
        on change rlb.value:
            sel_res = rlb.get_value()
            if sel_res is not None:
                RESEARCH_SEL = sel_res.key
            jump admiral_console_gui
        gui_section(style="area: 60, 18, 98, 82;")
        research_slot_line = "Research slots: " + str(len(research_current_list(adm_side))) + "/" + str(research_slots(adm_side)) + "   (build a Lab for more)"
        gui_row("row-height: 1.6em;")
        """$text:{research_slot_line};font:gui-1;color:#8cf"""
        if RESEARCH_SEL is None:
            """Select a milestone to inspect it."""
        else:
            rrec = research_def(RESEARCH_SEL)
            if rrec is not None:
                r_state = research_state(adm_side, RESEARCH_SEL)
                r_line = rrec.name + "  [" + rrec.branch + "]  -  " + r_state
                r_info = research_costs_text(RESEARCH_SEL) + "   " + str(rrec.time) + "s"
                r_desc = rrec.desc
                gui_row("row-height: 2.4em;")
                """$text:{r_line};font:gui-2"""
                gui_row("row-height: 2em;")
                """$text:{r_info};font:gui-1"""
                gui_row("row-height: 4em;")
                """$text:{r_desc};font:gui-1"""
                if r_state == "available":
                    gui_row("row-height: 2.2em;")
                    b_res = gui_button("Start research")
                    on gui_message(b_res):
                        RESEARCH_PICK = RESEARCH_SEL
                        jump admiral_research_start
        if ADM_MSG != "":
            gui_row("row-height: 2em;")
            """$text:{ADM_MSG};color:#fa4"""
    elif ADMIRAL_TAB == "fleets":
        # The navy: a scrollable officer roster; the context panel forms a
        # fleet for (or gives orders to) the selected officer.
        gui_section(style="area: 2, 18, 58, 82;")
        olb = gui_list_box(officer_list(), "row-height: 2.2em;", item_template=officer_list_template, title_template=officer_list_title, select=True)
        on change olb.value:
            sel_off = olb.get_value()
            if sel_off is not None:
                OFFICER_SEL = sel_off.key
            jump admiral_console_gui
        gui_section(style="area: 60, 18, 98, 82;")
        if OFFICER_SEL is None:
            """Select an officer. A fleet costs one command point."""
        else:
            orec = officer_def(OFFICER_SEL)
            if orec is not None:
                o_fleet = officer_fleet(OFFICER_SEL)
                o_line = orec.name + ", " + orec.title
                o_desc = orec.desc
                gui_row("row-height: 2.4em;")
                """$text:{o_line};font:gui-2"""
                gui_row("row-height: 4em;")
                """$text:{o_desc};font:gui-1"""
                if o_fleet is None:
                    gui_row("row-height: 2em;")
                    form_line = "Fleet cost - " + fleet_cost_text()
                    """$text:{form_line};font:gui-1"""
                    gui_row("row-height: 2.2em;")
                    b_form = gui_button("Form fleet")
                    on gui_message(b_form):
                        OFFICER_PICK = OFFICER_SEL
                        jump admiral_fleet_form
                else:
                    FLEET_PICK = o_fleet.key
                    fl_line = fleet_status_text(o_fleet.key)
                    gui_row("row-height: 2em;")
                    """$text:{fl_line};font:gui-1;color:#8cf"""
                    gui_row("row-height: 2.2em;")
                    b_o1 = gui_button("Escort")
                    b_o2 = gui_button("Patrol")
                    b_o3 = gui_button("Strike")
                    on gui_message(b_o1):
                        ORDER_PICK = "escort"
                        jump admiral_fleet_order
                    on gui_message(b_o2):
                        ORDER_PICK = "patrol"
                        jump admiral_fleet_order
                    on gui_message(b_o3):
                        ORDER_PICK = "strike"
                        jump admiral_fleet_order
                    gui_row("row-height: 2.2em;")
                    b_o4 = gui_button("Hold")
                    b_o5 = gui_button("Salvage")
                    b_o6 = gui_button("Withdraw")
                    on gui_message(b_o4):
                        ORDER_PICK = "hold"
                        jump admiral_fleet_order
                    on gui_message(b_o5):
                        ORDER_PICK = "salvage"
                        jump admiral_fleet_order
                    on gui_message(b_o6):
                        ORDER_PICK = "withdraw"
                        jump admiral_fleet_order
        if ADM_MSG != "":
            gui_row("row-height: 2em;")
            """$text:{ADM_MSG};color:#fa4"""
    elif ADMIRAL_TAB == "requisition":
        # Resources -> a real item delivered beside the player ships. The
        # catalog starts with the classic upgrades; research adds to it.
        gui_section(style="area: 2, 18, 58, 82;")
        qlb = gui_list_box(requisition_catalog_items(adm_side), "row-height: 2.2em;", item_template=requisition_list_template, title_template=requisition_list_title, select=True)
        on change qlb.value:
            sel_req = qlb.get_value()
            if sel_req is not None:
                REQ_SEL = sel_req.key
            jump admiral_console_gui
        gui_section(style="area: 60, 18, 98, 82;")
        gui_row("row-height: 3em;")
        """Requisitions are delivered beside the player ships - fly over to collect."""
        if REQ_SEL is not None:
            req_entry = requisition_entry(adm_side, REQ_SEL)
            if req_entry is not None:
                req_line = req_entry[1] + "   (" + requisition_costs_text(adm_side, REQ_SEL) + ")"
                gui_row("row-height: 2.4em;")
                """$text:{req_line};font:gui-2"""
                gui_row("row-height: 2.2em;")
                b_req = gui_button("Deliver")
                on gui_message(b_req):
                    REQ_PICK = REQ_SEL
                    jump admiral_requisition
        # Crew subsidy (resources -> station prices): one button cycles the
        # discount tier; the active rate drains the stockpiles each econ tick
        # (universe_worldlets) and discounts what the crews pay at any allied
        # station market (LM items.market_price reads the same side value).
        gui_row("row-height: 1.6em;")
        """$text:Crew Subsidy;font:gui-2;color:#8cf"""
        subsidy_rate = admiralty_subsidy_rate(adm_side)
        subsidy_line = str(int(subsidy_rate * 100)) + "% off station prices    upkeep " + admiralty_subsidy_upkeep_text(adm_side)
        gui_row("row-height: 2em;")
        """$text:{subsidy_line};font:gui-1"""
        gui_row("row-height: 2.2em;")
        b_sub = gui_button("Cycle subsidy tier")
        on gui_message(b_sub):
            jump admiral_subsidy_cycle
        if ADM_MSG != "":
            gui_row("row-height: 2em;")
            """$text:{ADM_MSG};color:#fa4"""
    elif ADMIRAL_TAB == "system":
        # A spatial view of the current system: the engine's 2D radar embedded in
        # the console (worldlets, platforms, fleets, threats, player ships). Basic
        # for now - Admiral overlays (supply radii, order tints) come later.
        gui_section(style="area: 2, 18, 98, 82;")
        gui_layout_widget("2dview")
    else:
        gui_section(style="area: 2, 20, 98, 60;")
        """$text:Select a tab above."""

    # Build queue line (the mock's bottom bar).
    if len(ADM_BUILDS) > 0:
        gui_section(style="area: 2, 84, 98, 92; background:#0006;")
        queue_text = ", ".join(ADM_BUILDS)
        """justify:left; $text:BUILDING - {queue_text}"""
    # Fabricator model: show its build queue instead (the menu queue stays empty).
    fab_queue = fabricator_queue(adm_side)
    if len(fab_queue) > 0:
        gui_section(style="area: 2, 84, 98, 92; background:#0006;")
        fab_text = ", ".join([admiralty_platform_def(fab_job["kind"]).get("name") for fab_job in fab_queue])
        """justify:left; $text:FABRICATOR - {fab_text}"""

    gui_sub_task_schedule("admiral_watch")
    await gui()

--- admiral_watch
    # Repaint when the economy moves (ticker change) or a build finishes.
    prev_sig = ticker + str(len(ADM_BUILDS))
    await delay_sim(3)
    ->END if not UNIVERSE_ACTIVE
    if prev_sig != admiralty_ticker_text(adm_side) + str(len(ADM_BUILDS)):
        gui_task_jump("admiral_console_gui")
    jump admiral_watch


=== admiral_set_tab
    ADMIRAL_TAB = TAB_KEY
    jump admiral_console_gui


=== admiral_build
    default BUILD_PICK = None
    default adm_side = universe_console_side(client_id)
    ADM_MSG = ""
    # Build model A/B (Admiralty `Build model:`). menu = instant + parallel task;
    # fabricator = pay + queue a builder ship that flies out and constructs
    # (universe_fabricator). Both validate + charge the same way.
    if admiralty_tuning("build_model", "menu") == "fabricator":
        build_fail = admiralty_can_build(BUILD_PICK, adm_side, SEL_WORLDLET, universe_sectors, f"{universe_i},{universe_j}")
        if build_fail is None:
            admiralty_spend(adm_side, admiralty_platform_def(BUILD_PICK).get("cost"))
            fabricator_enqueue(adm_side, BUILD_PICK, SEL_WORLDLET)
            ADM_MSG = "Fabricator dispatched to build " + admiralty_platform_def(BUILD_PICK).get("name") + "."
        else:
            ADM_MSG = build_fail
    else:
        build_fail = admiralty_try_build(BUILD_PICK, adm_side, SEL_WORLDLET, universe_sectors, f"{universe_i},{universe_j}")
        if build_fail is None:
            task_schedule(admiralty_build_task, {"build_kind": BUILD_PICK, "build_worldlet_id": SEL_WORLDLET, "build_side": adm_side})
        else:
            ADM_MSG = build_fail
    jump admiral_console_gui


=== admiral_research_start
    default RESEARCH_PICK = None
    default adm_side = universe_console_side(client_id)
    ADM_MSG = ""
    fail = research_try_start(adm_side, RESEARCH_PICK)
    if fail is None:
        task_schedule(admiralty_research_task, {"research_key": RESEARCH_PICK, "research_side": adm_side})
    else:
        ADM_MSG = fail
    jump admiral_console_gui


=== admiral_subsidy_cycle
    default adm_side = universe_console_side(client_id)
    ADM_MSG = ""
    new_subsidy = admiralty_subsidy_cycle(adm_side)
    universe_save_players()
    if new_subsidy > 0:
        ADM_MSG = "Crew subsidy set to " + str(int(new_subsidy * 100)) + "% off station prices."
    else:
        ADM_MSG = "Crew subsidy stood down."
    jump admiral_console_gui


=== admiral_fleet_form
    default OFFICER_PICK = None
    default adm_side = universe_console_side(client_id)
    ADM_MSG = ""
    fail = fleet_try_form(adm_side, OFFICER_PICK)
    if fail is None:
        officer_card(OFFICER_PICK, fleet_line("formed"))
    else:
        ADM_MSG = fail
    jump admiral_console_gui


=== admiral_fleet_order
    default FLEET_PICK = None
    default ORDER_PICK = None
    ADM_MSG = ""
    ack = fleet_set_order(FLEET_PICK, ORDER_PICK)
    if ack != "":
        officer_card(OFFICER_SEL, ack)
    jump admiral_console_gui


=== admiral_requisition
    default REQ_PICK = None
    default adm_side = universe_console_side(client_id)
    ADM_MSG = ""
    fail = requisition_try_deliver(adm_side, REQ_PICK)
    if fail is None:
        # Deliver the item beside the first player ship and tell the crews.
        req_entry = requisition_entry(adm_side, REQ_PICK)
        deliver_players = to_object_list(role("__player__"))
        if len(deliver_players) > 0:
            dpos = deliver_players[0].pos
            item_spawn(REQ_PICK, dpos.x + 600, dpos.y, dpos.z + 400)
            universe_info_card("Requisition delivered: " + req_entry[1] + " - collect nearby.", "Admiralty Quartermaster", "#0cf")
            ADM_MSG = req_entry[1] + " delivered."
        else:
            ADM_MSG = "No player ship to deliver to."
    else:
        ADM_MSG = fail
    jump admiral_console_gui


# --- Overseer comms: fleet orders (click a fleet hull on the 2D view) -------------
# The Admiral rides a camera tagged `admiral`; selecting one of its own fleet hulls
# in the comms 2D view opens this menu. Order buttons carry NO task-var conditions
# (the engine re-evaluates button conditions out of task, where the loop locals are
# gone); the current order is hidden with a build-time `if`, and every click block
# recomputes the fleet from COMMS_SELECTED_ID - a context var that survives to the
# click. This re-homes the tab console's admiral_fleet_order onto the map surface.
//enable/comms if has_roles(COMMS_ORIGIN_ID, "admiral") and has_roles(COMMS_SELECTED_ID, "adm_fleet")


//comms if has_roles(COMMS_ORIGIN_ID, "admiral") and has_roles(COMMS_SELECTED_ID, "adm_fleet")
    adm_fkey = fleet_of_ship(COMMS_SELECTED_ID)
    yield success if adm_fkey is None
    adm_ord = fleet_current_order(adm_fkey)
    if adm_ord != "escort":
        + "Escort the flagship":
            adm_ack = fleet_set_order(fleet_of_ship(COMMS_SELECTED_ID), "escort")
            comms_receive(adm_ack, "Order acknowledged", color="white", title_color="cyan")
    if adm_ord != "patrol":
        + "Patrol the system":
            adm_ack = fleet_set_order(fleet_of_ship(COMMS_SELECTED_ID), "patrol")
            comms_receive(adm_ack, "Order acknowledged", color="white", title_color="cyan")
    if adm_ord != "strike":
        + "Strike hostiles":
            adm_ack = fleet_set_order(fleet_of_ship(COMMS_SELECTED_ID), "strike")
            comms_receive(adm_ack, "Order acknowledged", color="white", title_color="cyan")
    if adm_ord != "hold":
        + "Hold position":
            adm_ack = fleet_set_order(fleet_of_ship(COMMS_SELECTED_ID), "hold")
            comms_receive(adm_ack, "Order acknowledged", color="white", title_color="cyan")
    if adm_ord != "salvage":
        + "Salvage wrecks":
            adm_ack = fleet_set_order(fleet_of_ship(COMMS_SELECTED_ID), "salvage")
            comms_receive(adm_ack, "Order acknowledged", color="white", title_color="cyan")
    if adm_ord != "withdraw":
        + "Withdraw to base":
            adm_ack = fleet_set_order(fleet_of_ship(COMMS_SELECTED_ID), "withdraw")
            comms_receive(adm_ack, "Order acknowledged", color="white", title_color="cyan")


# --- Overseer comms: build on a worldlet (click a worldlet on the 2D view) --------
# Select one of your worldlets; whatever the Admiralty can build there appears as
# buttons (the same admiralty_buildable_items list the Map tab used). The per-button
# platform kind + target worldlet are captured in the handler's data dict at BUILD
# time (safe) - never read at click time. Re-homes the Map-tab build list onto the
# map surface. NOTE: worldlets are behav_planet terrain; if the engine won't let
# comms select terrain, this route simply never fires and we anchor build on a
# station instead - the browser check tells us which.
//enable/comms if has_roles(COMMS_ORIGIN_ID, "admiral") and has_roles(COMMS_SELECTED_ID, "worldlet")


//comms if has_roles(COMMS_ORIGIN_ID, "admiral") and has_roles(COMMS_SELECTED_ID, "worldlet")
    # The building side is the selecting Admiral's own side (COMMS_ORIGIN.side), not
    # a hard-coded literal - so a rival-side Admiral builds/refreshes for its side.
    adm_side = COMMS_ORIGIN.side
    adm_here = f"{universe_i},{universe_j}"
    adm_items = admiralty_buildable_items(adm_side, COMMS_SELECTED_ID, universe_sectors, adm_here)
    yield success if len(adm_items) == 0
    for adm_it in adm_items:
        + "Build {adm_it.name} ({adm_it.cost})" admiral_overseer_build {"BUILD_PICK": adm_it.get("key"), "SEL_WORLDLET": COMMS_SELECTED_ID, "BUILD_SIDE": adm_side}


=== admiral_overseer_build
    default BUILD_PICK = None
    default SEL_WORLDLET = None
    # Side threaded from the initiating Admiral (falls back to the primary player
    # side for any caller that doesn't pass it).
    default BUILD_SIDE = universe_primary_side()
    adm_here = f"{universe_i},{universe_j}"
    adm_pdef = admiralty_platform_def(BUILD_PICK)
    adm_pname = adm_pdef.get("name") if adm_pdef is not None else "platform"
    if admiralty_tuning("build_model", "menu") == "fabricator":
        build_fail = admiralty_can_build(BUILD_PICK, BUILD_SIDE, SEL_WORLDLET, universe_sectors, adm_here)
        if build_fail is None:
            admiralty_spend(BUILD_SIDE, adm_pdef.get("cost"))
            fabricator_enqueue(BUILD_SIDE, BUILD_PICK, SEL_WORLDLET)
            ADM_LAST_MSG = "Fabricator dispatched to build " + adm_pname + "."
        else:
            ADM_LAST_MSG = build_fail
    else:
        build_fail = admiralty_try_build(BUILD_PICK, BUILD_SIDE, SEL_WORLDLET, universe_sectors, adm_here)
        if build_fail is None:
            task_schedule(admiralty_build_task, {"build_kind": BUILD_PICK, "build_worldlet_id": SEL_WORLDLET, "build_side": BUILD_SIDE})
            ADM_LAST_MSG = "Construction started: " + adm_pname + "."
        else:
            ADM_LAST_MSG = build_fail
    # Surface on the overseer status line (ADM_LAST_MSG) AND as an info card for the
    # tab console / any console with an info panel.
    universe_info_card(ADM_LAST_MSG, "Admiralty", "#0cf")
    # Refresh the worldlet's comms buttons now the build is underway (the started
    # item drops out of its own menu) - only for THIS side's cameras currently on
    # this worldlet (& role(BUILD_SIDE), so a rival Admiral isn't touched).
    comms_navigate_override(role("admiral_cam") & role(BUILD_SIDE), SEL_WORLDLET)
    ->END


# --- Overseer: click to pan the flag camera --------------------------------------
# The Admiral rides a detached camera; the comms 2D view fires //focus/comms on a
# click. Clicking an OBJECT recenters the camera on it (so you can chase a fleet or
# a worldlet to the middle of the view); clicking empty space pans to that point -
# reaching worldlets/fleets that sit past the opening view. Mirrors the GM cambot
# (gamemaster.mast: SCIENCE_ORIGIN.pos = pos). The //comms routes above still fire
# on object clicks for the actual menus - this just moves the eye.
//focus/comms if has_roles(COMMS_ORIGIN_ID, "admiral")
    ->END if COMMS_ORIGIN is None
    if COMMS_SELECTED_ID != 0 and COMMS_SELECTED is not None:
        COMMS_ORIGIN.pos = Vec3(COMMS_SELECTED.pos)
    elif EVENT.source_point is not None:
        adm_pt = Vec3(EVENT.source_point)
        if adm_pt.x != 0 or adm_pt.z != 0:
            COMMS_ORIGIN.pos = adm_pt


# --- Overseer: platform command menus --------------------------------------------
# The Admiral's own platforms are stations; selecting one adds Admiral actions to
# its comms (on top of the default station comms). This re-homes the tab console's
# Fleets / Research / Subsidy onto the map: commission at the Shipyard, research at
# the Lab, set subsidy at the HQ. Per-button keys are captured in the handler data
# dict at build time (never read at click time); handlers report via info card
# instead of jumping to the tab console.

# Shipyard: commission a fleet under an available officer (fleet_try_form validates
# Academy/Shipyard/command-points/cost; we only list officers with no fleet yet).
//enable/comms if has_roles(COMMS_ORIGIN_ID, "admiral") and has_roles(COMMS_SELECTED_ID, "admiral_shipyard")


//comms if has_roles(COMMS_ORIGIN_ID, "admiral") and has_roles(COMMS_SELECTED_ID, "admiral_shipyard")
    adm_side = COMMS_ORIGIN.side
    for adm_off in officer_list():
        if officer_fleet(adm_off.key) is None and officer_status(adm_off.key) == "active":
            + "Commission {adm_off.name} - {adm_off.title}" admiral_overseer_commission {"OFFICER_PICK": adm_off.key, "ADM_ACT_SIDE": adm_side}


=== admiral_overseer_commission
    default OFFICER_PICK = None
    default ADM_ACT_SIDE = universe_primary_side()
    fail = fleet_try_form(ADM_ACT_SIDE, OFFICER_PICK)
    if fail is None:
        officer_card(OFFICER_PICK, fleet_line("formed"))
        adm_ocmr = officer_def(OFFICER_PICK)
        adm_ocmr_name = adm_ocmr.name if adm_ocmr is not None else "An officer"
        ADM_LAST_MSG = adm_ocmr_name + " has taken command of a new fleet at the shipyard."
    else:
        ADM_LAST_MSG = fail
    ->END


# Lab: start an available research milestone (research_try_start validates slots).
//enable/comms if has_roles(COMMS_ORIGIN_ID, "admiral") and has_roles(COMMS_SELECTED_ID, "admiral_lab")


//comms if has_roles(COMMS_ORIGIN_ID, "admiral") and has_roles(COMMS_SELECTED_ID, "admiral_lab")
    adm_side = COMMS_ORIGIN.side
    for adm_res in research_list():
        if research_state(adm_side, adm_res.key) == "available":
            + "Research {adm_res.name} [{adm_res.branch}]" admiral_overseer_research {"RESEARCH_PICK": adm_res.key, "ADM_ACT_SIDE": adm_side}


=== admiral_overseer_research
    default RESEARCH_PICK = None
    default ADM_ACT_SIDE = universe_primary_side()
    fail = research_try_start(ADM_ACT_SIDE, RESEARCH_PICK)
    if fail is None:
        task_schedule(admiralty_research_task, {"research_key": RESEARCH_PICK, "research_side": ADM_ACT_SIDE})
        adm_rrec = research_def(RESEARCH_PICK)
        adm_rname = adm_rrec.name if adm_rrec is not None else "project"
        ADM_LAST_MSG = "Research started: " + adm_rname + "."
    else:
        ADM_LAST_MSG = fail
    universe_info_card(ADM_LAST_MSG, "Admiralty R&D", "#0cf")
    ->END


# HQ: cycle the crew subsidy (off -> tiers -> off), the same action the Map/econ
# tab exposed. Drains the pools while active (admiralty_subsidy_upkeep).
//enable/comms if has_roles(COMMS_ORIGIN_ID, "admiral") and has_roles(COMMS_SELECTED_ID, "admiral_hq")


//comms if has_roles(COMMS_ORIGIN_ID, "admiral") and has_roles(COMMS_SELECTED_ID, "admiral_hq")
    + "Adjust crew subsidy":
        adm_new_sub = admiralty_subsidy_cycle(COMMS_ORIGIN.side)
        universe_save_players()
        if adm_new_sub > 0:
            ADM_LAST_MSG = "Crew subsidy set to " + str(int(adm_new_sub * 100)) + "% off station prices."
        else:
            ADM_LAST_MSG = "Crew subsidy stood down."
        universe_info_card(ADM_LAST_MSG, "Admiralty Quartermaster", "#0cf")
